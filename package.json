{
  "name": "no-mistakes-monitor",
  "version": "0.1.0",
  "description": "One page that shows every agent session on your machine - Claude Code, Claude Desktop and pi - tells you which one is waiting for you, and jumps to that window when you click it.",
  "type": "module",
  "bin": {
    "nmmon": "bin/nmmon.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "oxlint src bin hooks public test scripts",
    "typecheck": "tsc --noEmit",
    "coverage": "node --test --experimental-test-coverage test/*.test.js",
    "tasks": "node scripts/tasks.js board",
    "tasks:links": "node scripts/tasks.js links",
    "tasks:validate": "node scripts/tasks.js validate"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "hooks/",
    "README.md"
  ],
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "26.1.2",
    "oxlint": "1.77.0",
    "typescript": "7.0.2"
  }
}
