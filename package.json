{
  "name": "raise-cli",
  "version": "0.1.0",
  "description": "One page that shows every agent session on your machine - Claude Code, Claude Desktop, pi and Codex - tells you which one is waiting for you, and jumps to that window when you click it.",
  "type": "module",
  "keywords": [
    "claude-code",
    "codex",
    "dashboard",
    "agent",
    "monitor",
    "tmux",
    "cli"
  ],
  "homepage": "https://github.com/mattwwatson/raise#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattwwatson/raise.git"
  },
  "bugs": {
    "url": "https://github.com/mattwwatson/raise/issues"
  },
  "author": "Matthew Watson",
  "bin": {
    "raise": "bin/raise.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "oxlint src bin hooks public test scripts",
    "typecheck": "tsc --noEmit",
    "coverage": "node --test --experimental-test-coverage test/*.test.js",
    "tasks": "node scripts/tasks.js board",
    "tasks:links": "node scripts/tasks.js links",
    "tasks:gate": "node scripts/tasks.js gate",
    "tasks:validate": "node scripts/tasks.js validate",
    "prepublishOnly": "npm run lint && npm test && npm run typecheck"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "hooks/",
    "README.md"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.1.2",
    "oxlint": "1.77.0",
    "typescript": "7.0.2"
  }
}
